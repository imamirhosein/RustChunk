+fn block_state_count(block: &str, template_states: usize, combinations: usize) -> Result<u32> {
+    let count = (template_states as u64)
+        .checked_mul(combinations as u64)
+        .ok_or_else(|| format!("{block}: block state count overflows"))?;
+    if count > MAX_STATES as u64 {
+        return Err(format!("{block}: {count} block states, more than the {MAX_STATES} a world can hold").into());
+    }
+    Ok(count as u32)
