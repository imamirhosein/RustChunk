+    #[test]
+    fn a_conflicting_usage_cannot_lower_an_existing_command_permission() {
+        let (t, levels, problems) = command_tree(
+            &[
+                NativeCommand::op("gate sub <value:integer>", 4),
+                NativeCommand::new("gate sub <value:word>"),
+            ],
+            |_| false,
+        );
+        assert_eq!(problems.len(), 1, "{problems:?}");
+        assert_eq!(levels["gate"], 4);
+        let gate = &t["children"]["gate"];
+        assert_eq!(gate["permissions"]["permission"]["level"], "owners");
+        let sub = &gate["children"]["sub"];
+        assert_eq!(sub["permissions"]["permission"]["level"], "owners");
+        assert_eq!(sub["children"]["value"]["parser"], "brigadier:integer");
+    }
