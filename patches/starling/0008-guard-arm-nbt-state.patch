+    #[test]
+    fn saved_arm_state_is_bounded_and_indices_are_checked() {
+        let points = std::iter::repeat(Tag::compound([
+            ("X", Tag::Int(1)),
+            ("Y", Tag::Int(2)),
+            ("Z", Tag::Int(3)),
+            ("Out", Tag::Int(0)),
+        ]))
+        .take(MAX_ARM_POINTS + 7)
+        .collect();
+        let tag = Tag::compound([
+            ("Points", Tag::List(points)),
+            ("Progress", Tag::Float(f32::NAN.to_bits())),
+            ("Rate", Tag::Float(f32::INFINITY.to_bits())),
+        ]);
+        let state = ArmState::read(Some(&tag));
+        assert_eq!(state.points.len(), MAX_ARM_POINTS);
+        assert_eq!(state.progress, 0.0);
+        assert_eq!(state.rate, 0.0);
+        assert_eq!(point_position(&state.points, 0), Some([1, 2, 3]));
+        assert_eq!(point_position(&state.points, i32::MAX), None);
+        assert_eq!(point_position(&state.points, -1), None);
+    }
