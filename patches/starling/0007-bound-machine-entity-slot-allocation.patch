 use super::{Game, spill};
 use horizon_client::items::ItemStack;
 use horizon_client::kinetics::{KineticPart, Machine};
 use horizon_world::nbt::Tag;
 
+/// NBT item slots are encoded as an unsigned byte. Never allocate more slots than
+/// that encoding can address, even when a remote block entity supplies a hostile Size.
+const MAX_MACHINE_SLOTS: usize = u8::MAX as usize + 1;
+
+fn bounded_slot_count(requested: i64, minimum: usize) -> usize {
+    let minimum = minimum.min(MAX_MACHINE_SLOTS);
+    usize::try_from(requested)
+        .unwrap_or(minimum)
+        .clamp(minimum, MAX_MACHINE_SLOTS)
+}
