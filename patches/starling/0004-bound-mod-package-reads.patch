+        .read_to_end(&mut bytes)
+        .map_err(|e| format!("{name}: {e}"))?;
+    if bytes.len() as u64 > limit {
+        return Err(format!("{name} is over the {limit}-byte limit"));
+    }
+    Ok(bytes)
